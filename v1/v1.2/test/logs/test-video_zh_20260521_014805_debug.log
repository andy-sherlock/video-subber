01:52:48.697 [transcriber] seg[302] KEEP      start=898.06 end=900.06 nsp=0.2992  text='Оно...'
01:52:48.697 [transcriber] seg[303] KEEP [?] start=912.06 end=914.06 nsp=0.2992 music=1 DISPUTE  text='Оно...'
01:52:48.697 [transcriber] seg[303] KEEP      start=912.06 end=914.06 nsp=0.2992  text='Оно...'
01:52:48.697 [transcriber] seg[305] KEEP      start=918.06 end=948.06 nsp=0.0994  text='Аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа'
01:52:48.697 [transcriber] seg[306] KEEP      start=948.06 end=950.26 nsp=0.4252  text='Да, давай больше.'
01:52:48.697 [transcriber] seg[307] KEEP      start=953.90 end=955.34 nsp=0.4252  text='Удал, продал?'
01:52:48.697 [transcriber] seg[308] KEEP      start=961.04 end=962.68 nsp=0.4252  text='Ах! Дай-дай-дай!'
01:52:48.697 [transcriber] seg[309] KEEP      start=964.58 end=966.10 nsp=0.4252  text='Боже мой, да-гух, he-да, да.'
01:52:48.697 [transcriber] seg[310] DROP L2   start=969.14 end=971.14 nsp=0.4252  text='Да, да-да, да-да, да.'
01:52:48.697 [transcriber] seg[311] KEEP      start=973.30 end=975.14 nsp=0.4252  text='Ублезгол, да-да.'
01:52:48.697 [transcriber] seg[312] KEEP      start=975.14 end=977.94 nsp=0.4844  text='Да, ты даже не об间!'
01:52:48.697 [transcriber] seg[313] KEEP      start=986.66 end=989.86 nsp=0.4844  text='Да, да, да, да.'
01:52:48.697 [transcriber] seg[314] KEEP      start=992.56 end=995.26 nsp=0.4844  text='А-а, б**, ах, ты что ты Красадов?'
01:52:48.697 [transcriber] seg[315] KEEP      start=995.26 end=996.98 nsp=0.4844  text='Удова, Садов.'
01:52:48.697 [transcriber] seg[316] KEEP      start=1001.22 end=1003.02 nsp=0.4844  text='Удова, да.'
01:52:48.697 [transcriber] seg[317] KEEP      start=1005.14 end=1015.14 nsp=0.5035  text='Беребные...'
