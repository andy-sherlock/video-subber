01:52:48.696 [transcriber] seg[263] KEEP      start=780.88 end=782.88 nsp=0.5363  text='Ну, в смысле, анал?'
01:52:48.696 [transcriber] seg[265] KEEP [?] start=782.88 end=784.88 nsp=0.5363 music=1 DISPUTE  text='Анал с сошных я не знаю.'
01:52:48.696 [transcriber] seg[265] KEEP      start=782.88 end=784.88 nsp=0.5363  text='Анал с сошных я не знаю.'
01:52:48.696 [transcriber] seg[267] KEEP [?] start=784.88 end=787.88 nsp=0.5363 music=1 DISPUTE  text='Мне это первый раз будет как-то...'
01:52:48.696 [transcriber] seg[267] KEEP      start=784.88 end=787.88 nsp=0.5363  text='Мне это первый раз будет как-то...'
01:52:48.696 [transcriber] seg[269] KEEP [?] start=787.88 end=789.88 nsp=0.5363 music=1 DISPUTE  text='Я буду.'
01:52:48.696 [transcriber] seg[269] KEEP      start=787.88 end=789.88 nsp=0.5363  text='Я буду.'
01:52:48.696 [transcriber] seg[271] KEEP [?] start=789.88 end=791.88 nsp=0.5363 music=1 DISPUTE  text='Вот так видно, да? Да, да.'
01:52:48.696 [transcriber] seg[271] KEEP      start=789.88 end=791.88 nsp=0.5363  text='Вот так видно, да? Да, да.'
01:52:48.696 [transcriber] seg[273] KEEP [?] start=791.88 end=792.88 nsp=0.5363 music=1 DISPUTE  text='Лаз дады.'
01:52:48.696 [transcriber] seg[273] KEEP      start=791.88 end=792.88 nsp=0.5363  text='Лаз дады.'
01:52:48.696 [transcriber] seg[275] KEEP [?] start=792.88 end=794.88 nsp=0.5363 music=1 DISPUTE  text='Слушай, ну звучит, конечно, классно.'
01:52:48.696 [transcriber] seg[275] KEEP      start=792.88 end=794.88 nsp=0.5363  text='Слушай, ну звучит, конечно, классно.'
01:52:48.696 [transcriber] seg[277] KEEP [?] start=794.88 end=796.88 nsp=0.5363 music=1 DISPUTE  text='Ну, только будет, старожа, ладно?'
01:52:48.696 [transcriber] seg[277] KEEP      start=794.88 end=796.88 nsp=0.5363  text='Ну, только будет, старожа, ладно?'
01:52:48.697 [transcriber] seg[279] KEEP [?] start=796.88 end=797.88 nsp=0.5363 music=1 DISPUTE  text='Это мой первый раз все-таки.'
01:52:48.697 [transcriber] seg[279] KEEP      start=796.88 end=797.88 nsp=0.5363  text='Это мой первый раз все-таки.'
01:52:48.697 [transcriber] seg[281] KEEP [?] start=797.88 end=799.88 nsp=0.5363 music=1 DISPUTE  text='Ну, ты вставляй, да?'
01:52:48.697 [transcriber] seg[281] KEEP      start=797.88 end=799.88 nsp=0.5363  text='Ну, ты вставляй, да?'
01:52:48.697 [transcriber] seg[283] KEEP [?] start=799.88 end=800.88 nsp=0.5363 music=1 DISPUTE  text='Ну, да.'
01:52:48.697 [transcriber] seg[283] KEEP      start=799.88 end=800.88 nsp=0.5363  text='Ну, да.'
01:52:48.697 [transcriber] seg[285] KEEP [?] start=800.88 end=801.88 nsp=0.5363 music=1 DISPUTE  text='Ты готова?'
01:52:48.697 [transcriber] seg[285] KEEP      start=800.88 end=801.88 nsp=0.5363  text='Ты готова?'
01:52:48.697 [transcriber] seg[287] KEEP [?] start=801.88 end=803.88 nsp=0.1611 music=1 DISPUTE  text='Да, только спальшка расченька.'
01:52:48.697 [transcriber] seg[287] KEEP      start=801.88 end=803.88 nsp=0.1611  text='Да, только спальшка расченька.'
01:52:48.697 [transcriber] seg[289] KEEP      start=811.84 end=813.78 nsp=0.1611  text='Ой, уже ты потоку больше сейчас видан.'
01:52:48.697 [transcriber] seg[290] KEEP      start=815.08 end=817.28 nsp=0.1611  text='Кубы были там дорожним.'
01:52:48.697 [transcriber] seg[291] KEEP      start=826.80 end=828.80 nsp=0.1611  text='Ой, обориться!'
01:52:48.697 [transcriber] seg[292] KEEP [?] start=829.48 end=831.66 nsp=0.1611 music=1 DISPUTE  text='Да, давай ещё, да, да, да.'
01:52:48.697 [transcriber] seg[292] KEEP      start=829.48 end=831.66 nsp=0.1611  text='Да, давай ещё, да, да, да.'
01:52:48.697 [transcriber] seg[294] KEEP      start=861.88 end=872.36 nsp=0.2678  text='Уа-у-у.'
01:52:48.697 [transcriber] seg[295] KEEP      start=872.36 end=875.64 nsp=0.2678  text='Саня.'
01:52:48.697 [transcriber] seg[296] KEEP      start=875.64 end=879.76 nsp=0.2678  text='Это кладно да?'
01:52:48.697 [transcriber] seg[297] KEEP      start=879.76 end=881.48 nsp=0.2678  text='Уа-у-у.'
01:52:48.697 [transcriber] seg[298] KEEP [?] start=881.48 end=883.88 nsp=0.2678 music=1 DISPUTE  text='Саня, лёдя, лёдя...'
01:52:48.697 [transcriber] seg[298] KEEP      start=881.48 end=883.88 nsp=0.2678  text='Саня, лёдя, лёдя...'
01:52:48.697 [transcriber] seg[300] KEEP      start=883.88 end=888.06 nsp=0.2678  text='А, я, я, все же это хени, он пущет.'
